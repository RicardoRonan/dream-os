<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.kvaynwahey.Ds4BatteryTray" path="/io/github/kvaynwahey/Ds4BatteryTray/">
    <key name="interval" type="i">
      <default>12</default>
      <summary>Poll interval</summary>
      <description>Seconds between controller battery polls</description>
    </key>
    <key name="autostart" type="b">
      <default>false</default>
      <summary>Autostart</summary>
      <description>Start the tray app on login</description>
    </key>
    <key name="diameter" type="i">
      <default>5</default>
      <range min="1" max="10"/>
      <summary>Tray pin icon diameter</summary>
      <description>Pin icon diameter in tenths of the dock icon diameter. Dock icons are 48px, so 5 = 24px.</description>
    </key>
  </schema>
</schemalist>
