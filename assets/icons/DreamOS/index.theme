[Icon Theme]
Name=DreamOS
Comment=Dream OS overrides (session, window and app icons) over WhiteSur and Papirus
Inherits=WhiteSur-grey-dark,WhiteSur-grey,Papirus-Dark,Cosmic,Papirus,breeze-dark,hicolor
Directories=scalable/actions,scalable/apps

[scalable/actions]
Size=24
Type=Scalable
Context=Actions

[scalable/apps]
Size=128
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
